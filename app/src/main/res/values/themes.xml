<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Single Unified App Theme -->
    <style name="Theme.EpubReader" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/palette_eggplant</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
        <item name="colorPrimary">@color/palette_plum</item>
        <item name="colorPrimaryVariant">@color/palette_purple</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/palette_slate</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/palette_eggplant</item>
        <item name="colorSurface">@color/palette_plum</item>
        <item name="colorOnSurface">@color/palette_mint</item>
        <item name="android:textColorPrimary">@color/palette_mint</item>
        <item name="android:textColorSecondary">@color/palette_slate</item>
        <item name="colorControlNormal">@color/white</item>
        <item name="toolbarStyle">@style/Widget.EpubReader.Toolbar</item>
        <item name="drawerArrowStyle">@style/Widget.EpubReader.DrawerArrowToggle</item>
    </style>

</resources>
