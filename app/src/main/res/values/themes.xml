<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Main app / bookshelf theme (Always Dark). -->
    <style name="Theme.EpubReader" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/dark_bg</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/accent_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/dark_bg</item>
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorOnSurface">@color/dark_text</item>
        <item name="android:textColorPrimary">@color/dark_text</item>
        <item name="android:textColorSecondary">@color/dark_text_muted</item>
        <item name="colorControlNormal">@color/white</item>
        <item name="toolbarStyle">@style/Widget.EpubReader.Toolbar</item>
        <item name="drawerArrowStyle">@style/Widget.EpubReader.DrawerArrowToggle</item>
    </style>

    <!-- Reader activity. -->
    <style name="Theme.EpubReader.Reader" parent="Theme.EpubReader">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@color/reader_chrome_bg</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
        <item name="android:colorBackground">@color/reader_chrome_bg</item>
        <item name="colorSurface">@color/reader_chrome_surface</item>
        <item name="colorOnSurface">@color/reader_chrome_text</item>
        <item name="android:textColorPrimary">@color/reader_chrome_text</item>
        <item name="android:textColorSecondary">@color/reader_chrome_text_muted</item>
        <item name="bottomSheetDialogTheme">@style/Theme.EpubReader.Reader.Sheet</item>
    </style>

    <!-- Settings sheet. -->
    <style name="Theme.EpubReader.Reader.Sheet" parent="Theme.MaterialComponents.DayNight.BottomSheetDialog">
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
        <item name="colorSurface">@color/reader_chrome_surface</item>
        <item name="colorPrimary">@color/reader_chrome_accent</item>
        <item name="colorOnPrimary">@color/palette_eggplant</item>
        <item name="android:textColorPrimary">@color/reader_chrome_text</item>
        <item name="android:textColorSecondary">@color/reader_chrome_text_muted</item>
    </style>

    <!-- Full-screen reader settings ACTIVITY. -->
    <style name="Theme.EpubReader.Settings" parent="Theme.EpubReader.Reader">
        <item name="android:windowBackground">@color/reader_chrome_bg</item>
        <item name="android:colorBackground">@color/reader_chrome_bg</item>
        <item name="colorSurface">@color/reader_chrome_surface</item>
        <item name="colorOnSurface">@color/reader_chrome_text</item>
        <item name="colorPrimary">@color/reader_chrome_accent</item>
        <item name="colorOnPrimary">@color/palette_eggplant</item>
        <item name="android:textColorPrimary">@color/reader_chrome_text</item>
        <item name="android:textColorSecondary">@color/reader_chrome_text_muted</item>
    </style>
</resources>
