<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ReaderSettingLabel" parent="Widget.MaterialComponents.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textColor">@color/palette_slate</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="ReaderToggleBtn" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/reader_toggle_text_color</item>
        <item name="strokeColor">@color/reader_toggle_stroke_color</item>
        <item name="backgroundTint">@color/reader_toggle_bg_tint</item>
    </style>

    <!-- ===== Patch 17: full-screen reader settings activity =====
         The activity theme (Theme.EpubReader.Settings) is the static reader
         chrome: eggplant background, white text, mint accents. These styles
         keep every control on that surface. -->

    <!-- Stepper row: a horizontal row with a [−] icon button, the live value
         centered (weight 1), and a [+] icon button. Icon-only Material buttons
         with a tint that matches the chrome accent. -->
    <style name="ReaderStepperBtn" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconTint">@color/palette_plum</item>
        <item name="rippleColor">@color/palette_plum</item>
    </style>

    <!-- The numeric value between the +/- buttons. -->
    <style name="ReaderStepperValue" parent="Widget.MaterialComponents.TextView">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/palette_mint</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- A toggle row (switch + caps label above) laid out exactly like the
         stepper rows so the whole screen reads as one consistent list. -->
    <style name="ReaderSwitchRow" parent="Widget.MaterialComponents.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- ===== Patch 18 (Fix #1): shared icon-button style — the SINGLE SOURCE
         OF TRUTH for icon-button size + background ripple, applied to every
         reader icon button (top bar, seeker prev/next, overlay back, search
         back) and item_bookmark's delete button. Reused buttons (back / search /
         settings / chevrons) can never drift out of sync. Override
         android:layout_width/height per location when a different touch size is
         needed. Tint is NOT set here — see the note inside the style. -->

    <style name="EpubReaderIconButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <!-- Tint is NOT set here. Icons are white vectors on dark reader chrome,
             so they render white from their own color. Set app:tint on a view only
             for a non-white tint or when used on a light background. -->
    </style>
    <style name="ReaderSelectionToolbarAction" parent="android:style/Widget.TextView">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">@dimen/app_selection_toolbar_action_min_width</item>
        <item name="android:layout_marginStart">@dimen/app_selection_toolbar_action_margin_h</item>
        <item name="android:layout_marginEnd">@dimen/app_selection_toolbar_action_margin_h</item>
        <item name="android:paddingStart">@dimen/app_selection_toolbar_action_padding_h</item>
        <item name="android:paddingEnd">@dimen/app_selection_toolbar_action_padding_h</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/app_selection_toolbar_text_size</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="ReaderSelectionToolbarMoreAction" parent="android:style/Widget.ImageButton">
        <item name="android:layout_width">@dimen/app_selection_toolbar_action_min_width</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">@dimen/app_selection_toolbar_action_padding_h</item>
        <item name="android:paddingEnd">@dimen/app_selection_toolbar_action_padding_h</item>
        <item name="android:layout_marginStart">@dimen/app_selection_toolbar_action_margin_h</item>
        <item name="android:layout_marginEnd">@dimen/app_selection_toolbar_action_margin_h</item>
        <item name="android:minWidth">@dimen/app_selection_toolbar_action_min_width</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:tint">@color/white</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Semantic Toolbar style: automatically tints navigation icons, menu actions, and titles -->
    <style name="Widget.EpubReader.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="titleTextColor">@color/palette_mint</item>
        <item name="subtitleTextColor">@color/palette_slate</item>
        <item name="navigationIconTint">@color/palette_mint</item>
        <item name="actionMenuTextColor">@color/palette_mint</item>
    </style>

    <!-- Semantic Hamburger / Back-Arrow toggle style -->
    <style name="Widget.EpubReader.DrawerArrowToggle" parent="Widget.AppCompat.DrawerArrowToggle">
        <item name="color">@color/palette_mint</item>
    </style>

    <!-- Individual Folder Action Button Styles -->
    <style name="Widget.EpubReader.FolderButton.ScanNow" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/black</item>
        <item name="backgroundTint">@color/palette_violet</item>
    </style>

    <style name="Widget.EpubReader.FolderButton.RefreshMetadata" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/palette_eggplant</item>
    </style>

    <style name="Widget.EpubReader.FolderButton.SelectFolder" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/palette_eggplant</item>
    </style>

    <style name="Widget.EpubReader.FolderButton.RemoveFolder" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/palette_eggplant</item>
    </style>

    <style name="ShapeAppearance.TopRounded" parent="">
        <item name="cornerSizeTopLeft">6dp</item>
        <item name="cornerSizeTopRight">6dp</item>
        <item name="cornerSizeBottomLeft">2dp</item>
        <item name="cornerSizeBottomRight">2dp</item>
    </style>

    <style name="ShapeAppearance.LeftSideRounded" parent="">
        <item name="cornerSizeTopLeft">6dp</item>
        <item name="cornerSizeTopRight">6dp</item>
        <item name="cornerSizeBottomLeft">6dp</item>
        <item name="cornerSizeBottomRight">6dp</item>
    </style>
</resources>
