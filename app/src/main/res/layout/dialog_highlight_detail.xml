<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_margin="24dp"
    app:cardBackgroundColor="@color/palette_eggplant"
    app:cardCornerRadius="20dp"
    app:cardElevation="6dp"
    app:strokeColor="@color/palette_plum"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header: Color dot + title + close icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="12dp">

            <View
                android:id="@+id/detailColorDot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/oval_rounded_bg" />

            <TextView
                android:id="@+id/tvDetailTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/highlight_details"
                android:textColor="@color/palette_mint"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnCloseDetail"
                style="@style/EpubReaderIconButton"
                android:contentDescription="@string/close"
                app:srcCompat="@drawable/ic_close"
                app:tint="@color/palette_mint" />
        </LinearLayout>

        <!-- Light divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/palette_plum"
            android:alpha="0.4"
            android:layout_marginBottom="16dp" />

        <!-- Highlight card row container -->
        <LinearLayout
            android:id="@+id/detailTextContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/reader_search_input_bg"
            android:orientation="horizontal"
            android:padding="0dp"
            android:layout_marginBottom="16dp">

            <View
                android:id="@+id/detailLeftAccentBar"
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:background="@color/palette_violet" />

            <TextView
                android:id="@+id/detailHighlightText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="4"
                android:padding="14dp"
                android:textColor="@color/palette_mint"
                android:textSize="14sp"
                android:textStyle="italic" />
        </LinearLayout>

        <!-- Personal Note Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/personal_note"
                app:srcCompat="@drawable/ic_note"
                app:tint="@color/palette_plum" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/personal_note"
                android:textColor="@color/palette_plum"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnAddEditNote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"
                android:text="@string/add_note"
                android:textColor="@color/palette_plum"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Note display or input section -->
        <TextView
            android:id="@+id/detailNoNoteText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="12dp"
            android:text="@string/no_note_attached"
            android:textColor="@color/palette_slate"
            android:textSize="13sp"
            android:textStyle="italic" />

        <!-- Saved note text display container -->
        <LinearLayout
            android:id="@+id/detailNoteTextContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/reader_search_input_bg"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/detailNoteTextDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/palette_mint"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutDetailNoteInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/etDetailNoteInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/reader_search_input_bg"
                android:gravity="top"
                android:hint="@string/highlight_note_hint"
                android:maxLines="3"
                android:minLines="2"
                android:padding="12dp"
                android:textColor="@color/palette_mint"
                android:textColorHint="@color/palette_slate"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="end"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDetailCancelNote"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cancel"
                    android:textColor="@color/palette_slate" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDetailSaveNote"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@color/palette_violet"
                    android:text="@string/save_note"
                    android:textColor="@color/white" />
            </LinearLayout>
        </LinearLayout>

        <!-- Light divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/palette_plum"
            android:alpha="0.4"
            android:layout_marginTop="@dimen/app_definition_row_spacing"
            android:layout_marginBottom="16dp" />

        <!-- Bottom Actions Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDetailDelete"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/delete_highlight"
                android:textColor="@color/palette_violet"
                android:background="@drawable/rounded_square_bg"
                app:icon="@drawable/ic_delete"
                app:iconTint="@color/palette_violet" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDetailClose"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ok"
                android:textColor="@color/palette_mint"
                app:strokeColor="@color/palette_plum" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
