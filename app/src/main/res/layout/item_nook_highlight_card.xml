<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/palette_plum"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/palette_purple"
    app:strokeWidth="1dp"
    app:contentPadding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="HIGHLIGHT"
                android:textColor="@color/palette_mint"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textAllCaps="true" />

            <TextView
                android:id="@+id/highlightDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/palette_slate"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Quote Box with thick vertical accent bar matching highlight color -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/palette_eggplant"
            android:orientation="horizontal"
            android:padding="12dp">

            <View
                android:id="@+id/highlightAccentLine"
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:background="@color/palette_violet" />

            <TextView
                android:id="@+id/highlightQuote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="@color/palette_mint"
                android:textSize="14sp"
                android:textStyle="italic"
                android:lineSpacingMultiplier="1.25" />
        </LinearLayout>

        <!-- Personal Note Box -->
        <LinearLayout
            android:id="@+id/highlightNoteBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/nook_personal_note_header"
                android:textColor="@color/palette_violet"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/highlightNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/palette_mint"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
