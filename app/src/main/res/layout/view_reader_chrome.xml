<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/reader_chrome_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Top bar (4 rows) -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/palette_eggplant"
        android:elevation="6dp"
        android:orientation="vertical"
        android:paddingStart="@dimen/app_chrome_padding_h"
        android:paddingTop="@dimen/app_text_row_padding_h"
        android:paddingEnd="@dimen/app_chrome_padding_h"
        android:paddingBottom="@dimen/app_chrome_padding_v"
        android:visibility="gone">

        <!-- Row 1: controls — back (left) + toc/bookmark/search/settings (right). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                style="@style/EpubReaderIconButton"
                android:contentDescription="@string/action_back"
                app:srcCompat="@drawable/ic_arrow_back"
                app:tint="@color/palette_slate" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnToc"
                style="@style/EpubReaderIconButton"
                android:contentDescription="@string/action_toc"
                app:srcCompat="@drawable/ic_toc"
                app:tint="@color/palette_slate"/>

            <ImageButton
                android:id="@+id/btnBookmarks"
                style="@style/EpubReaderIconButton"
                android:contentDescription="@string/action_bookmarks"
                app:srcCompat="@drawable/ic_bookmarks_view"
                app:tint="@color/palette_slate"/>

            <ImageButton
                android:id="@+id/btnHighlights"
                style="@style/EpubReaderIconButton"
                android:contentDescription="@string/action_highlights"
                app:srcCompat="@drawable/ic_highlight"
                app:tint="@color/palette_slate"/>

            <ImageButton
                android:id="@+id/btnSearch"
                style="@style/EpubReaderIconButton"
                android:contentDescription="@string/action_search"
                app:srcCompat="@drawable/ic_search"
                app:tint="@color/palette_slate" />

            <ImageButton
                android:id="@+id/btnReadAloud"
                style="@style/EpubReaderIconButton"
                android:contentDescription="@string/action_read_aloud"
                app:srcCompat="@drawable/ic_volume"
                app:tint="@color/palette_slate" />

            <ImageButton
                android:id="@+id/btnSettings"
                style="@style/EpubReaderIconButton"
                android:contentDescription="@string/action_settings"
                app:srcCompat="@drawable/ic_settings"
                app:tint="@color/palette_slate" />
        </LinearLayout>

        <!-- Row 2: book title (bold, full width). -->
        <TextView
            android:id="@+id/tvBookTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="@dimen/app_reader_icon_inset"
            android:paddingEnd="@dimen/app_reader_icon_inset"
            android:textColor="@color/palette_slate"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Row 3: author (+ series - book# if available), light, start-aligned. -->
        <TextView
            android:id="@+id/tvAuthorSeries"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="@dimen/app_reader_icon_inset"
            android:paddingEnd="@dimen/app_reader_icon_inset"
            android:textColor="@color/palette_purple"
            android:textSize="13sp" />

        <!-- Row 4: current TOC section name + page X/Y within that section. -->
        <TextView
            android:id="@+id/tvSectionPages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="@dimen/app_reader_icon_inset"
            android:paddingEnd="@dimen/app_reader_icon_inset"
            android:textColor="@color/palette_purple"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Bottom bar: chapter nav + progress + bold whole-book page X/Y -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/palette_eggplant"
        android:elevation="6dp"
        android:orientation="vertical"
        android:paddingStart="0dp"
        android:paddingTop="0dp"
        android:paddingEnd="0dp"
        android:paddingBottom="@dimen/app_chrome_padding_v"
        android:visibility="gone">

        <!-- Reader history: full-width visual section attached directly to the top of the bottom chrome. -->
        <FrameLayout
            android:id="@+id/readerHistory"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="0dp"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="8dp"
            android:background="@color/palette_eggplant"
            android:elevation="0dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/app_row_content_padding_h"
                android:paddingEnd="@dimen/app_row_content_padding_h">

                <TextView
                    android:id="@+id/readerHistoryBack"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:gravity="center_vertical|start"
                    android:textColor="@color/reader_history_text"
                    android:textSize="12sp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/readerHistoryClear"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:gravity="center"
                    android:text="@string/reader_history_clear"
                    android:textColor="@color/reader_history_text"
                    android:textSize="12sp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/readerHistoryForward"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:gravity="center_vertical|end"
                    android:textColor="@color/reader_history_text"
                    android:textSize="12sp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/tvPageInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/app_chrome_padding_v"
            android:gravity="center"
            android:paddingTop="@dimen/app_chrome_padding_v"
            android:paddingStart="@dimen/app_row_content_padding_h"
            android:paddingEnd="@dimen/app_row_content_padding_h"
            android:paddingBottom="@dimen/app_chrome_padding_v"
            android:textColor="@color/palette_slate"
            android:textSize="14sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/seekChapter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/app_row_content_padding_h"
            android:paddingEnd="@dimen/app_row_content_padding_h"
            android:progressBackgroundTint="@color/palette_plum"
            android:progressBackgroundTintMode="src_atop"
            android:progressTint="@color/palette_purple"
            android:thumbTint="@color/palette_purple" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/app_chrome_padding_v"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPercent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:padding="@dimen/app_chrome_padding_v"
                android:paddingStart="@dimen/app_row_content_padding_h"
                android:textColor="@color/palette_purple"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvAddBookmark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/app_chrome_padding_v"
                android:padding="@dimen/app_chrome_padding_v"
                android:paddingEnd="@dimen/app_row_content_padding_h"
                android:text="@string/add_bookmark"
                android:textColor="@color/palette_purple"
                android:textSize="14sp"
                app:drawableStartCompat="@drawable/ic_bookmark_add"
                app:drawableTint="@color/palette_slate" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
