<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Measurement WebView (behind the main one so it never intercepts touches).
         INVISIBLE (not GONE) so it still measures + lays out for page counting. -->
    <WebView
        android:id="@+id/measureWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible" />

    <com.epubreader.app.ui.LivreWebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white" />

    <!-- Snapshot overlay for seamless cross-chapter transitions: a bitmap of the
         page being left is shown here, then faded out once the target chapter's
         page is positioned + revealed (see capturePageSnapshot/dismissPageSnapshot).
         Sits above the reading WebView, below chrome and overlays. -->
    <ImageView
        android:id="@+id/snapshotView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/reader_contents"
        android:scaleType="fitStart"
        android:visibility="gone" />

    <!-- Persistent page indicator: faint "X / Y" above the nav bar,
         visible only during normal reading (hidden when chrome/overlays open).
         No background pill — blends into the page like Kindle/ReadEra.
         Text color is the reader ink at reduced alpha (set in applyWindowTheme)
         so it contrasts with the page but stays unobtrusive. -->
    <TextView
        android:id="@+id/tvPageIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="6dp"
        android:alpha="0.55"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:visibility="gone" />

    <include
        android:id="@+id/reader_chrome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        layout="@layout/view_reader_chrome" />

    <!-- Full-screen Contents + Bookmarks overlay -->
    <FrameLayout
        android:id="@+id/tocBookmarkOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/palette_eggplant"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/app_chrome_padding_h"
                android:paddingTop="@dimen/app_chrome_padding_v"
                android:paddingEnd="@dimen/app_chrome_padding_h"
                android:paddingBottom="@dimen/app_chrome_padding_v">

                <ImageButton
                    android:id="@+id/btnOverlayBack"
                    style="@style/EpubReaderIconButton"
                    android:contentDescription="@string/action_back"
                    app:srcCompat="@drawable/ic_arrow_back"
                    app:tint="@color/palette_slate" />

                <TextView
                    android:id="@+id/tvOverlayTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:paddingStart="@dimen/app_reader_icon_inset"
                    android:paddingEnd="@dimen/app_reader_icon_inset"
                    android:textColor="@color/palette_slate"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <!-- Balance the 44dp back button so the centered title is truly
                     centered on screen (symmetric left/right weight). -->
                <Space
                    android:layout_width="@dimen/app_icon_button_size"
                    android:layout_height="@dimen/app_icon_button_size" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/overlayTabGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/app_row_content_padding_h"
                android:paddingEnd="@dimen/app_row_content_padding_h"
                android:paddingBottom="@dimen/app_row_content_padding_h"
                app:singleSelection="true"
                app:selectionRequired="true">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTabContents"
                    style="@style/ReaderToggleBtn"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/reader_tab_contents" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTabBookmarks"
                    style="@style/ReaderToggleBtn"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/reader_tab_bookmarks" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTabHighlights"
                    style="@style/ReaderToggleBtn"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/reader_tab_highlights" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <FrameLayout
                android:id="@+id/overlayContent"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/searchOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/palette_eggplant"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Row 1: back arrow at the chrome keyline (glyph lands at 20dp),
             toolbar-height. Mirror of the TOC/bookmark overlay header. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/app_chrome_padding_h"
            android:paddingTop="@dimen/app_chrome_padding_v"
            android:paddingEnd="@dimen/app_chrome_padding_h"
            android:paddingBottom="@dimen/app_chrome_padding_v">

            <ImageButton
                android:id="@+id/btnSearchBack"
                style="@style/EpubReaderIconButton"
                android:contentDescription="@string/action_back"
                app:srcCompat="@drawable/ic_arrow_back"
                app:tint="@color/palette_slate" />
        </LinearLayout>

        <!-- Row 2: search box full-width at the 20dp content keyline so its
             left/right edges align with the search results below (item rows at
             20dp). Equal margin on both sides = symmetric on all edges. -->
        <EditText
            android:id="@+id/searchEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/app_row_content_padding_h"
            android:layout_marginTop="@dimen/app_row_padding_v"
            android:layout_marginEnd="@dimen/app_row_content_padding_h"
            android:layout_marginBottom="@dimen/app_row_padding_v"
            android:background="@drawable/reader_search_input_bg"
            android:hint="@string/reader_search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:padding="@dimen/app_row_padding_h"
            android:textColor="@color/white"
            android:textColorHint="@color/palette_slate"
            android:textSize="15sp" />

        <FrameLayout
            android:id="@+id/searchContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- Read Aloud (TTS) overlay included from separate styling layout file -->
    <include
        android:id="@+id/tts_overlay_include"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        layout="@layout/view_tts_overlay" />

</FrameLayout>
