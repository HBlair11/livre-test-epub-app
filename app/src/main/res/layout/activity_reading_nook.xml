<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/palette_eggplant"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/palette_eggplant"
        app:elevation="0dp">

        <FrameLayout
            android:id="@+id/headerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="@dimen/app_screen_end_padding"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/app_row_content_padding_h"
            android:paddingEnd="@dimen/app_row_content_padding_h"
            android:paddingTop="@dimen/app_row_content_padding_h">

            <!-- SECTION 1: BOOK HERO PROFILE CARD -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/palette_plum"
                app:cardCornerRadius="10dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="@dimen/app_row_content_padding_h">

                    <!-- Centered Book Cover -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="140dp"
                        android:layout_height="210dp"
                        android:layout_gravity="center_horizontal"
                        app:cardCornerRadius="6dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:id="@+id/nookCover"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/cover_frame"
                            android:contentDescription="@string/book_cover"
                            android:scaleType="centerCrop" />
                    </androidx.cardview.widget.CardView>

                    <!-- Badge Pill: Black background, oval shape, reading nook icon, text "Authoritative Reading State" in plum -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/pill_bg_black_plum"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="6dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_explore"
                            app:tint="@color/palette_plum" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/nook_authoritative_state"
                            android:textColor="@color/palette_plum"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Book Title -->
                    <TextView
                        android:id="@+id/nookTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:textColor="@color/palette_mint"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <!-- Author & Series -->
                    <TextView
                        android:id="@+id/nookAuthorSeries"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:textColor="@color/palette_slate"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Inner Container Card with Eggplant Background for Status, Progress, and Quick Stats -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        app:cardBackgroundColor="@color/palette_eggplant"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="0dp"
                        app:contentPadding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <!-- Status Row (Centered, no 'Status:' label, properly rounded chips) -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="20dp"
                                android:gravity="center"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/chipStatusUnread"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/chip_bg"
                                    android:paddingStart="14dp"
                                    android:paddingTop="6dp"
                                    android:paddingEnd="14dp"
                                    android:paddingBottom="6dp"
                                    android:text="@string/nook_status_unread"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/chipStatusReading"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:background="@drawable/chip_bg"
                                    android:paddingStart="14dp"
                                    android:paddingTop="6dp"
                                    android:paddingEnd="14dp"
                                    android:paddingBottom="6dp"
                                    android:text="@string/nook_status_reading"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/chipStatusFinished"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:background="@drawable/chip_bg"
                                    android:paddingStart="14dp"
                                    android:paddingTop="6dp"
                                    android:paddingEnd="14dp"
                                    android:paddingBottom="6dp"
                                    android:text="@string/nook_status_finished"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <!-- Reading Progress Section -->
                            <!-- Inner Container Card with Plum Background for Progress, Progress %, Progress Bar and Current Location -->
                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="20dp"
                                android:layout_marginBottom="20dp"
                                app:cardBackgroundColor="@color/palette_plum"
                                app:state_dragged="@color/palette_violet"
                                app:cardCornerRadius="10dp"
                                app:cardElevation="0dp"
                                app:contentPadding="12dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="14dp"
                                    android:layout_marginBottom="14dp"
                                    android:orientation="vertical">

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal">

                                        <TextView
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:text="@string/home_progress"
                                            android:textColor="@color/palette_mint"
                                            android:textSize="12sp"
                                            android:textStyle="bold" />

                                        <TextView
                                            android:id="@+id/nookProgressPercent"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:textColor="@color/palette_violet"
                                            android:textSize="12sp"
                                            android:textStyle="bold" />
                                    </LinearLayout>

                                    <ProgressBar
                                        android:id="@+id/nookProgressBar"
                                        style="?android:attr/progressBarStyleHorizontal"
                                        android:layout_width="match_parent"
                                        android:layout_height="8dp"
                                        android:layout_marginTop="10dp"
                                        android:progressDrawable="@drawable/progress_line_rounded_book_list" />

                                    <!-- Current Location (Center-aligned below progress section) -->
                                    <TextView
                                        android:id="@+id/nookCurrentLocation"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="10dp"
                                        android:gravity="center"
                                        android:textColor="@color/palette_slate"
                                        android:textSize="12sp"
                                        android:ellipsize="end"
                                        android:maxLines="1"
                                        android:textStyle="italic" />

                                </LinearLayout>

                            </com.google.android.material.card.MaterialCardView>

                            <!-- Quick Stats Row (2 lines, 2 items per line separated by bullets) -->
                            <!-- Quick Stats Container -->
                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="20dp"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp">

                                <!-- A vertical guideline locked at exactly 50% width to act as our true center -->
                                <androidx.constraintlayout.widget.Guideline
                                    android:id="@+id/centerGuideline"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    app:layout_constraintGuide_percent="0.5" />

                                <!-- ================= ROW 1 ================= -->

                                <!-- Row 1 Bullet: Placed exactly in the center -->
                                <TextView
                                    android:id="@+id/bulletRow1"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="•"
                                    android:textColor="@color/palette_slate"
                                    android:textSize="12sp"
                                    app:layout_constraintTop_toTopOf="parent"
                                    app:layout_constraintStart_toStartOf="@id/centerGuideline"
                                    app:layout_constraintEnd_toEndOf="@id/centerGuideline" />

                                <!-- Row 1 Left Group (Icon + Text Container) -->
                                <LinearLayout
                                    android:id="@+id/layoutRow1Left"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical|end"
                                    android:orientation="horizontal"
                                    android:layout_marginEnd="8dp"
                                    app:layout_constraintTop_toTopOf="@id/bulletRow1"
                                    app:layout_constraintBottom_toBottomOf="@id/bulletRow1"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintEnd_toStartOf="@id/bulletRow1">

                                    <ImageView
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:contentDescription="@null"
                                        android:src="@drawable/ic_schedule"
                                        app:tint="@color/palette_slate" />

                                    <TextView
                                        android:id="@+id/nookStatTime"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="8dp"
                                        android:textColor="@color/palette_slate"
                                        android:textSize="12sp" />
                                </LinearLayout>

                                <!-- Row 1 Right Group (Icon + Text Container) -->
                                <LinearLayout
                                    android:id="@+id/layoutRow1Right"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical|start"
                                    android:orientation="horizontal"
                                    android:layout_marginStart="8dp"
                                    app:layout_constraintTop_toTopOf="@id/bulletRow1"
                                    app:layout_constraintBottom_toBottomOf="@id/bulletRow1"
                                    app:layout_constraintStart_toEndOf="@id/bulletRow1"
                                    app:layout_constraintEnd_toEndOf="parent">

                                    <ImageView
                                        android:layout_width="14dp"
                                        android:layout_height="14dp"
                                        android:contentDescription="@null"
                                        android:src="@drawable/ic_ink_highlighter"
                                        app:tint="@color/palette_slate" />

                                    <TextView
                                        android:id="@+id/nookStatHighlights"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="8dp"
                                        android:textColor="@color/palette_slate"
                                        android:textSize="12sp" />
                                </LinearLayout>

                                <!-- ================= ROW 2 ================= -->

                                <!-- Row 2 Bullet: Placed exactly in the center under Row 1 -->
                                <TextView
                                    android:id="@+id/bulletRow2"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="•"
                                    android:textColor="@color/palette_slate"
                                    android:textSize="12sp"
                                    app:layout_constraintTop_toBottomOf="@id/bulletRow1"
                                    app:layout_constraintStart_toStartOf="@id/centerGuideline"
                                    app:layout_constraintEnd_toEndOf="@id/centerGuideline" />

                                <!-- Row 2 Left Group (Icon + Text Container) -->
                                <LinearLayout
                                    android:id="@+id/layoutRow2Left"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical|end"
                                    android:orientation="horizontal"
                                    android:layout_marginEnd="8dp"
                                    app:layout_constraintTop_toTopOf="@id/bulletRow2"
                                    app:layout_constraintBottom_toBottomOf="@id/bulletRow2"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintEnd_toStartOf="@id/bulletRow2">

                                    <ImageView
                                        android:layout_width="14dp"
                                        android:layout_height="14dp"
                                        android:contentDescription="@null"
                                        android:src="@drawable/ic_stamp"
                                        app:tint="@color/palette_slate" />

                                    <TextView
                                        android:id="@+id/nookStatStamps"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="8dp"
                                        android:textColor="@color/palette_slate"
                                        android:textSize="12sp" />
                                </LinearLayout>

                                <!-- Row 2 Right Group (Icon + Text Container) -->
                                <LinearLayout
                                    android:id="@+id/layoutRow2Right"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical|start"
                                    android:orientation="horizontal"
                                    android:layout_marginStart="8dp"
                                    app:layout_constraintTop_toTopOf="@id/bulletRow2"
                                    app:layout_constraintBottom_toBottomOf="@id/bulletRow2"
                                    app:layout_constraintStart_toEndOf="@id/bulletRow2"
                                    app:layout_constraintEnd_toEndOf="parent">

                                    <ImageView
                                        android:layout_width="14dp"
                                        android:layout_height="14dp"
                                        android:contentDescription="@null"
                                        android:src="@drawable/ic_ink_pen"
                                        app:tint="@color/palette_slate" />

                                    <TextView
                                        android:id="@+id/nookStatJournals"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="8dp"
                                        android:textColor="@color/palette_slate"
                                        android:textSize="12sp" />
                                </LinearLayout>

                            </androidx.constraintlayout.widget.ConstraintLayout>

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- SECTION 2: NOOK NAVIGATION TABS BAR -->
            <HorizontalScrollView
                android:id="@+id/nookTabsScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tabOverview"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="@string/nook_tab_overview"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:icon="@drawable/ic_candle" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tabJournal"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:text="@string/nook_tab_journal"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:icon="@drawable/ic_ink_pen" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tabStamps"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:text="@string/nook_tab_stamps"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:icon="@drawable/ic_stamp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/tabHighlights"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:text="@string/nook_tab_highlights"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:icon="@drawable/ic_ink_highlighter" />
                </LinearLayout>
            </HorizontalScrollView>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="20dp"
                android:background="@color/palette_purple" />

            <!-- SECTION 3: TAB CONTENT CONTAINER -->
            <FrameLayout
                android:id="@+id/nookTabContentContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
