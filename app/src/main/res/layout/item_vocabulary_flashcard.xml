<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/flashcardCardView"
    android:layout_width="match_parent"
    android:layout_height="380dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="18dp"
    app:cardElevation="6dp"
    app:strokeColor="@color/accent_pop"
    app:strokeWidth="1dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp">

        <!-- Front Side -->
        <LinearLayout
            android:id="@+id/flashcardFrontSide"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/flashcardWord"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/palette_mint"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/flashcardPhonetic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/palette_slate"
                android:textSize="14sp"
                android:textStyle="italic" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/vocab_tap_to_flip"
                android:textColor="@color/accent_pop"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Back Side -->
        <LinearLayout
            android:id="@+id/flashcardBackSide"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/flashcardPos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/oval_rounded_bg"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="@color/accent_pop"
                android:textSize="12sp"
                android:textStyle="bold|italic" />

            <TextView
                android:id="@+id/flashcardDef"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="@color/palette_mint"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/flashcardExample"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="@color/dark_text_muted"
                android:textSize="13sp"
                android:textStyle="italic" />
        </LinearLayout>
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
