<?xml version="1.0" encoding="utf-8"?>
<!-- Contextual dictionary card shown near the text selection.
     Styled to match the highlight details popup card with stroke border and bottom close button. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/app_popup_screen_margin"
    app:cardBackgroundColor="@color/palette_eggplant"
    app:cardCornerRadius="20dp"
    app:cardElevation="@dimen/app_definition_card_elevation"
    app:strokeColor="@color/palette_plum"
    app:strokeWidth="1dp"
    app:contentPadding="@dimen/app_card_padding">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ScrollView
            android:id="@+id/dictScroll"
            android:layout_width="@dimen/app_definition_card_max_width"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Header Row: Word + Badge + Audio Pronunciation -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/dictWord"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/palette_mint"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/dictPartOfSpeech"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/pill_bg_purple"
                        android:paddingStart="10dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="3dp"
                        android:textColor="@color/palette_eggplant"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <ImageButton
                        android:id="@+id/dictPronounceBtn"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/item_background_borderless_material"
                        android:contentDescription="@string/tts_play"
                        android:src="@drawable/ic_volume"
                        app:tint="@color/palette_mint" />
                </LinearLayout>

                <!-- Light divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/palette_plum"
                    android:alpha="0.4"
                    android:layout_marginTop="@dimen/app_definition_row_spacing"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:id="@+id/dictNoResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/app_definition_row_spacing"
                    android:text="@string/dictionary_not_found"
                    android:textColor="@color/palette_slate"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/dictEntries"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/app_definition_row_spacing"
                    android:orientation="vertical" />

                <!-- Indented Context Quote Box -->
                <LinearLayout
                    android:id="@+id/dictQuoteBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:padding="10dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/dictContextQuote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/reader_search_input_bg"
                        android:padding="10dp"
                        app:cornerRadius="10dp"
                        android:textColor="@color/palette_slate"
                        android:textSize="13sp"
                        android:textStyle="italic" />
                </LinearLayout>

                <TextView
                    android:id="@+id/dictSuggestionsLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/app_definition_row_spacing"
                    android:text="@string/dictionary_did_you_mean"
                    android:textColor="@color/palette_slate"
                    android:textSize="12sp"
                    android:textStyle="italic"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/dictSuggestions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/app_definition_row_spacing"
                    android:orientation="vertical" />

                <!-- Light divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/palette_plum"
                    android:alpha="0.4"
                    android:layout_marginTop="@dimen/app_definition_row_spacing"
                    android:layout_marginBottom="16dp" />

                <!-- Action Button: Save to Vocabulary Sanctuary -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dictSaveBtn"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/app_definition_row_spacing"
                    android:text="@string/vocabulary_save_to_sanctuary"
                    android:textColor="@color/black"
                    app:backgroundTint="@color/palette_violet"
                    app:cornerRadius="10dp"
                    app:iconTint="@color/black" />

                <!-- Secondary action button when word already exists in vocabulary -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dictRefreshExistingBtn"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/app_definition_row_spacing"
                    android:text="@string/vocabulary_refresh_existing"
                    android:textColor="@color/palette_mint"
                    app:cornerRadius="10dp"
                    app:strokeColor="@color/palette_slate"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dictExternalButton"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/app_definition_row_spacing"
                    android:text="@string/dictionary_lookup_external"
                    android:textColor="@color/palette_slate"
                    android:visibility="gone" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
