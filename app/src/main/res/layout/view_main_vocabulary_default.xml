<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/vocabScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:paddingBottom="@dimen/app_screen_end_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/app_row_content_padding_h"
        android:paddingEnd="@dimen/app_row_content_padding_h"
        android:paddingTop="@dimen/app_screen_start_below_header">

        <!-- 1. Vocabulary Builder Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_vocab_builder"
                    app:tint="@color/palette_mint" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/vocab_heading_title"
                    android:textColor="@color/palette_mint"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/vocabSubtitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/vocab_heading_subtitle"
                android:textColor="@color/palette_slate"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.2" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="@dimen/app_row_content_padding_h"
            android:background="@color/palette_purple" />

        <!-- Words Section -->
        <LinearLayout
            android:id="@+id/vocabWordsTabContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Search Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/vocabSearchLayout"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:hint="@string/vocab_search_hint"
                app:boxStrokeColor="@color/palette_plum"
                app:boxCornerRadiusTopStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusBottomEnd="10dp"
                app:startIconDrawable="@drawable/ic_search"
                app:endIconMode="clear_text"
                app:endIconDrawable="@drawable/ic_close">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/vocabSearchEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionSearch"
                    android:saveEnabled="false"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/palette_mint"
                    android:textColorHint="@color/palette_slate"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Export / Clear Action Buttons Row -->
            <LinearLayout
                android:id="@+id/vocabActionsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/vocabExportCsv"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="@string/vocabulary_export_csv"
                    android:textColor="@color/white"
                    app:strokeColor="@color/palette_violet"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/vocabExportMarkdown"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:text="@string/vocabulary_export_markdown"
                    android:textColor="@color/white"
                    app:strokeColor="@color/palette_violet"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/vocabClearAll"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/action_clear_all"
                    android:textColor="@color/white"
                    app:strokeColor="@color/palette_violet"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Vocabulary Empty State Text -->
            <TextView
                android:id="@+id/vocabEmptyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="32dp"
                android:text="@string/vocabulary_empty"
                android:textColor="@color/palette_slate"
                android:textSize="14sp" />

            <!-- Vocabulary Words Recycler -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/vocabRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />
        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
