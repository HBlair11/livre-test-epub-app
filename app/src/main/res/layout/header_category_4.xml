<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.appbar.MaterialToolbar xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/toolbar"
    android:layout_width="match_parent"
    android:layout_height="?attr/actionBarSize"
    android:background="@color/palette_plum"
    app:title="@string/app_name"
    app:titleTextColor="@color/palette_mint">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/libBtnSearch"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/item_background_borderless_material"
            android:contentDescription="@string/action_search_books"
            android:padding="6dp"
            android:src="@drawable/ic_search"
            app:tint="@color/palette_mint" />

        <ImageButton
            android:id="@+id/libBtnViewMode"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/item_background_borderless_material"
            android:contentDescription="@string/action_view_mode"
            android:padding="8dp"
            android:src="@drawable/ic_grid"
            app:tint="@color/palette_mint" />

        <ImageButton
            android:id="@+id/addImportBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/rounded_square_bg"
            android:contentDescription="@string/action_import_file"
            android:padding="8dp"
            android:src="@drawable/ic_add"
            app:tint="@color/black" />
    </LinearLayout>
</com.google.android.material.appbar.MaterialToolbar>
