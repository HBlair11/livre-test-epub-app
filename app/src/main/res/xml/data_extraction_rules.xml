<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="epub.db" />
        <include domain="database" path="epub.db-shm" />
        <include domain="database" path="epub.db-wal" />
        <include domain="sharedpref" path="com.epubreader.app_preferences.xml" />
        <!--<exclude domain="file" path="books/" />
        <exclude domain="external" path="." />-->
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="epub.db" />
        <include domain="database" path="epub.db-shm" />
        <include domain="database" path="epub.db-wal" />
        <include domain="sharedpref" path="com.epubreader.app_preferences.xml" />
        <!--<exclude domain="file" path="books/" />
        <exclude domain="external" path="." />-->
    </device-transfer>
</data-extraction-rules>
